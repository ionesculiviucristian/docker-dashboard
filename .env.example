# ============================
# Globals
# ============================

COMPOSE_PROJECT_NAME="dev"

TZ="Europe/Bucharest"

SERVICES_DOMAIN="services.local"
SERVICES_USER="developer"
SERVICES_USER_EMAIL="${SERVICES_USER}@mailpit.${SERVICES_DOMAIN}"
SERVICES_USER_PASSWORD="1q2w3e4r5t6y"

# ============================
# Services
# ============================

AUTHENTIK="services/authentik/docker-compose.yml"
CADVISOR="services/cadvisor/docker-compose.yml"
GRAFANA="services/grafana/docker-compose.yml"
HOMEPAGE="services/homepage/docker-compose.yml"
IT_TOOLS="services/it-tools/docker-compose.yml"
MAILPIT="services/mailpit/docker-compose.yml"
MEALIE="services/mealie/docker-compose.yml"
MINIO="services/minio/docker-compose.yml"
MONGO="services/mongo/docker-compose.yml"
MYSQL="services/mysql/docker-compose.yml"
N8N="services/n8n/docker-compose.yml"
OLLAMA_AMDGPU="services/ollama/docker-compose.amdgpu.yml"
OLLAMA="services/ollama/docker-compose.yml"
OMNI_TOOLS="services/omni-tools/docker-compose.yml"
POSTGRES="services/postgres/docker-compose.yml"
PROMETHEUS="services/prometheus/docker-compose.yml"
RABBITMQ="services/rabbitmq/docker-compose.yml"
REDIS="services/redis/docker-compose.yml"
TRAEFIK="services/traefik/docker-compose.yml"
WHATSUPDOCKER="services/whatsupdocker/docker-compose.yml"

# ============================
# Profiles
# ============================

AI_PROFILE="${OLLAMA}:${OLLAMA_AMDGPU}:${N8N}"
DATABASE_PROFILE="${MINIO}:${MONGO}:${MYSQL}:${POSTGRES}:${REDIS}"
MISC_PROFILE="${CADVISOR}:${MAILPIT}:${RABBITMQ}:${WHATSUPDOCKER}"
PERSONAL_PROFILE="${MEALIE}"
PROFILING_PROFILE="${GRAFANA}:${PROMETHEUS}"
TOOLS_PROFILE="${IT_TOOLS}:${OMNI_TOOLS}"

PROXY=${TRAEFIK}

COMPOSE_FILE="${PROXY}:${AUTHENTIK}:${HOMEPAGE}:${AI_PROFILE}:${DATABASE_PROFILE}:${MISC_PROFILE}:${PROFILING_PROFILE}:${TOOLS_PROFILE}:${PERSONAL_PROFILE}"

# ============================
# Variables
# ============================

# authentik
AUTHENTIK_NETWORK="${COMPOSE_PROJECT_NAME}-authentik"
AUTHENTIK_VERSION="2025.10.3"
AUTHENTIK_VIRTUAL_HOST="authentik.${SERVICES_DOMAIN}"
AUTHENTIK_VIRTUAL_PORT=9000

AUTHENTIK_BOOTSTRAP_EMAIL="${SERVICES_USER_EMAIL}"
AUTHENTIK_BOOTSTRAP_PASSWORD="${SERVICES_USER_PASSWORD}"
AUTHENTIK_SECRET_KEY=""

AUTHENTIK_POSTGRES_VERSION="18.1"

AUTHENTIK_POSTGRES_DB="authentik"
AUTHENTIK_POSTGRES_USER="${SERVICES_USER}"
AUTHENTIK_POSTGRES_USER_PASSWORD="${SERVICES_USER_PASSWORD}"

# cAdvisor
CADVISOR_VERSION="v0.55.1"
CADVISOR_VIRTUAL_HOST="cadvisor.${SERVICES_DOMAIN}"
CADVISOR_VIRTUAL_PORT=8080

# Grafana
GRAFANA_VERSION="12.3.1"
GRAFANA_VIRTUAL_HOST="grafana.${SERVICES_DOMAIN}"
GRAFANA_VIRTUAL_PORT=3000

GRAFANA_GF_SECURITY_ADMIN_USER="${SERVICES_USER}"
GRAFANA_GF_SECURITY_ADMIN_PASSWORD="${SERVICES_USER_PASSWORD}"

GRAFANA_ALLOY_VERSION="v1.12.1"
GRAFANA_ALLOY_VIRTUAL_HOST="grafana-alloy.${SERVICES_DOMAIN}"
GRAFANA_ALLOY_VIRTUAL_PORT=12345

GRAFANA_ALLOY_LOGGING_LEVEL="info"

GRAFANA_LOKI_VERSION="3.6.3"

# homepage
HOMEPAGE_VERSION="v1.8.0"
HOMEPAGE_VIRTUAL_HOST="homepage.${SERVICES_DOMAIN}"

# IT TOOLS
IT_TOOLS_VERSION="latest"
IT_TOOLS_VIRTUAL_HOST="it-tools.${SERVICES_DOMAIN}"

# Mailpit
MAILPIT_NETWORK="${COMPOSE_PROJECT_NAME}-mailpit"
MAILPIT_VERSION="v1.28"
MAILPIT_VIRTUAL_HOST="mailpit.${SERVICES_DOMAIN}"
MAILPIT_VIRTUAL_PORT=8025

# Mealie
MEALIE_VERSION="v3.9.2"
MEALIE_VIRTUAL_HOST="mealie.${SERVICES_DOMAIN}"
MEALIE_VIRTUAL_PORT=9000

# MinIO
MINIO_NETWORK="${COMPOSE_PROJECT_NAME}-minio"
MINIO_VERSION="RELEASE.2025-09-07T16-13-09Z"
MINIO_VIRTUAL_HOST="minio.${SERVICES_DOMAIN}"
MINIO_VIRTUAL_PORT=9001

MINIO_ROOT_PASSWORD="${SERVICES_USER_PASSWORD}"
MINIO_ROOT_USER="${SERVICES_USER}"

# Mongo
MONGO_NETWORK="${COMPOSE_PROJECT_NAME}-mongo"
MONGO_VERSION="8.2.3"
MONGO_VIRTUAL_HOST="mongo-express.${SERVICES_DOMAIN}"
MONGO_VIRTUAL_PORT=8081

MONGO_EXPORTER_USER_PASSWORD="${SERVICES_USER_PASSWORD}"
MONGO_EXPORTER_USER="exporter"
MONGO_GLIBC_TUNABLES="glibc.pthread.rseq=0"
MONGO_INITDB_ROOT_PASSWORD="${SERVICES_USER_PASSWORD}"
MONGO_INITDB_ROOT_USERNAME="${SERVICES_USER}"
MONGO_PROFILE=0

MONGO_ME_CONFIG_BASICAUTH_PASSWORD="${SERVICES_USER_PASSWORD}"
MONGO_ME_CONFIG_BASICAUTH_USERNAME="${SERVICES_USER}"
MONGO_ME_CONFIG_OPTIONS_EDITORTHEME="monokai"
MONGO_ME_VERSION="1.0"

MONGO_PROMETHEUS_EXPORTER_VERSION="0.47.1"

# MySQL
MYSQL_NETWORK="${COMPOSE_PROJECT_NAME}-mysql"
MYSQL_VERSION="9.5"

MYSQL_ROOT_PASSWORD="${SERVICES_USER_PASSWORD}"
MYSQL_EXPORTER_USER="exporter"
MYSQL_EXPORTER_USER_PASSWORD="${SERVICES_USER_PASSWORD}"

MYSQL_PHPMYADMIN_PMA_UPLOAD_LIMIT="1G"
MYSQL_PHPMYADMIN_VERSION="5.2.3"
MYSQL_PHPMYADMIN_VIRTUAL_HOST="phpmyadmin.${SERVICES_DOMAIN}"

MYSQL_PROMETHEUS_EXPORTER_VERSION="v0.18.0"

# n8n
N8N_VERSION="2.3.0"
N8N_VIRTUAL_HOST="n8n.${SERVICES_DOMAIN}"
N8N_VIRTUAL_PORT=5678

# ollama
OLLAMA_VERSION="0.13.5"
OLLAMA_MODEL="deepseek-coder-v2:16b"

OLLAMA_OPEN_WEBUI_VERSION="v0.6.43"
OLLAMA_OPEN_WEBUI_VIRTUAL_HOST="open-webui.${SERVICES_DOMAIN}"
OLLAMA_OPEN_WEBUI_VIRTUAL_PORT=8080
OLLAMA_OPEN_WEBUI_WEBUI_SECRET_KEY=""

# Omni Tools
OMNI_TOOLS_VERSION="0.6.0"
OMNI_TOOLS_VIRTUAL_HOST="omni-tools.${SERVICES_DOMAIN}"

# PostgreSQL
POSTGRES_NETWORK="${COMPOSE_PROJECT_NAME}-postgres"
POSTGRES_VERSION="18.1"

POSTGRES_USER="${SERVICES_USER}"
POSTGRES_USER_PASSWORD="${SERVICES_USER_PASSWORD}"
POSTGRES_EXPORTER_USER="exporter"
POSTGRES_EXPORTER_USER_PASSWORD="${SERVICES_USER_PASSWORD}"

POSTGRES_PGADMIN4_PGADMIN_DEFAULT_EMAIL="${SERVICES_USER_EMAIL}"
POSTGRES_PGADMIN4_PGADMIN_DEFAULT_PASSWORD="${SERVICES_USER_PASSWORD}"
POSTGRES_PGADMIN4_PGADMIN_VERSION="9.11"
POSTGRES_PGADMIN4_VIRTUAL_HOST="pgadmin4.${SERVICES_DOMAIN}"

POSTGRES_PROMETHEUS_EXPORTER_VERSION="v0.18.1"

# Prometheus
PROMETHEUS_NETWORK="${COMPOSE_PROJECT_NAME}-prometheus"
PROMETHEUS_VERSION="v3.8.1"
PROMETHEUS_VIRTUAL_HOST="prometheus.${SERVICES_DOMAIN}"
PROMETHEUS_VIRTUAL_PORT=9090

PROMETHEUS_BLACKBOX_EXPORTER_VERSION="v0.28.0"
PROMETHEUS_NODE_EXPORTER_VERSION="v1.10.2"

# RabbitMQ
RABBITMQ_NETWORK="${COMPOSE_PROJECT_NAME}-rabbitmq"
RABBITMQ_VERSION="4.2.2-management-alpine"
RABBITMQ_VIRTUAL_HOST="rabbitmq.${SERVICES_DOMAIN}"
RABBITMQ_VIRTUAL_PORT=15672

RABBITMQ_DEFAULT_PASS="${SERVICES_USER_PASSWORD}"
RABBITMQ_DEFAULT_USER="${SERVICES_USER}"

# Redis
REDIS_NETWORK="${COMPOSE_PROJECT_NAME}-redis"
REDIS_VERSION="8.4-alpine"
REDIS_VIRTUAL_HOST="redisinsight.${SERVICES_DOMAIN}"
REDIS_VIRTUAL_PORT=5540

REDIS_PASSWORD="${SERVICES_USER_PASSWORD}"

REDIS_REDISINSIGHT_VERSION="2.70"

REDIS_EXPORTER_VERSION="v1.80.1"

# Traefik
TRAEFIK_NETWORK="${COMPOSE_PROJECT_NAME}-traefik"
TRAEFIK_VERSION="v3.6.6"
TRAEFIK_VIRTUAL_HOST="traefik.${SERVICES_DOMAIN}"
TRAEFIK_VIRTUAL_PORT=8080

TRAEFIK_WHOAMI_VERSION="v1.11"
TRAEFIK_WHOAMI_VIRTUAL_HOST="whoami.${SERVICES_DOMAIN}"

# What's up Docker?
WHATSUPDOCKER_VERSION="8.1.1"
WHATSUPDOCKER_VIRTUAL_HOST="whatsupdocker.${SERVICES_DOMAIN}"

WHATSUPDOCKER_WUD_REGISTRY_CUSTOM_OSGEO_URL="https://docker.osgeo.org/repository/geoserver-docker"

# Proxy
PROXY_NETWORK="${TRAEFIK_NETWORK}"
