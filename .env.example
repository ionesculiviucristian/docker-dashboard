# ============================
# Globals
# ============================

COMPOSE_PROJECT_NAME="ddp"

SERVICES_DOMAIN_NAME="services.local"
SERVICES_USER="developer"
SERVICES_USER_EMAIL="${SERVICES_USER}@mailpit.${SERVICES_DOMAIN_NAME}"
SERVICES_USER_PASSWORD="1q2W3e4r5T6y"

# ============================
# Services
# ============================

AUTHENTIK="services/authentik/docker-compose.yml"
CADVISOR="services/cadvisor/docker-compose.yml"
DOZZLE="services/dozzle/docker-compose.yml"
GOTIFY="services/gotify/docker-compose.yml"
GRAFANA="services/grafana/docker-compose.yml"
HOMEPAGE="services/homepage/docker-compose.yml"
IT_TOOLS="services/it-tools/docker-compose.yml"
MAILPIT="services/mailpit/docker-compose.yml"
MEALIE="services/mealie/docker-compose.yml"
MINIO="services/minio/docker-compose.yml"
MONGO="services/mongo/docker-compose.yml"
MYSQL="services/mysql/docker-compose.yml"
N8N="services/n8n/docker-compose.yml"
OLLAMA_AMDGPU="services/ollama/docker-compose.amdgpu.yml"
OLLAMA_NVIDIAGPU="services/ollama/docker-compose.nvidiagpu.yml"
OLLAMA="services/ollama/docker-compose.yml"
OMNI_TOOLS="services/omni-tools/docker-compose.yml"
POSTGRES="services/postgres/docker-compose.yml"
PROMETHEUS="services/prometheus/docker-compose.yml"
RABBITMQ="services/rabbitmq/docker-compose.yml"
REDIS="services/redis/docker-compose.yml"
TRAEFIK="services/traefik/docker-compose.yml"
WHATSUPDOCKER="services/whatsupdocker/docker-compose.yml"

# ============================
# Profiles
# ============================

AI_PROFILE="${OLLAMA}:${N8N}"
DATABASE_PROFILE="${MINIO}:${MONGO}:${MYSQL}:${POSTGRES}:${REDIS}"
MISC_PROFILE="${CADVISOR}:${DOZZLE}:${GOTIFY}:${MAILPIT}:${RABBITMQ}:${WHATSUPDOCKER}"
PERSONAL_PROFILE="${MEALIE}"
PROFILING_PROFILE="${GRAFANA}:${PROMETHEUS}"
TOOLS_PROFILE="${IT_TOOLS}:${OMNI_TOOLS}"

PROXY="${TRAEFIK}"

COMPOSE_FILE="${PROXY}:${AUTHENTIK}:${HOMEPAGE}:${AI_PROFILE}:${DATABASE_PROFILE}:${MISC_PROFILE}:${PROFILING_PROFILE}:${TOOLS_PROFILE}:${PERSONAL_PROFILE}"

# ============================
# Variables
# ============================

# authentik
AUTHENTIK_HOSTNAME_PORT=9000
AUTHENTIK_HOSTNAME="authentik.${SERVICES_DOMAIN_NAME}"
AUTHENTIK_NETWORK="${COMPOSE_PROJECT_NAME}-authentik"
AUTHENTIK_VERSION="2025.12.4"

AUTHENTIK_BOOTSTRAP_EMAIL="${SERVICES_USER_EMAIL}"
AUTHENTIK_BOOTSTRAP_PASSWORD="${SERVICES_USER_PASSWORD}"
AUTHENTIK_BOOTSTRAP_TOKEN=""
AUTHENTIK_SECRET_KEY=""

AUTHENTIK_POSTGRES_VERSION="18.1"

AUTHENTIK_POSTGRES_DB="authentik"
AUTHENTIK_POSTGRES_USER_PASSWORD="${SERVICES_USER_PASSWORD}"
AUTHENTIK_POSTGRES_USER="${SERVICES_USER}"

# cAdvisor
CADVISOR_HOSTNAME_PORT=8080
CADVISOR_HOSTNAME="cadvisor.${SERVICES_DOMAIN_NAME}"
CADVISOR_VERSION="v0.55.1"

# Dozzle
DOZZLE_HOSTNAME_PORT=8080
DOZZLE_HOSTNAME="dozzle.${SERVICES_DOMAIN_NAME}"
DOZZLE_VERSION="v10.0.3"

# Gotify
GOTIFY_HOSTNAME_PORT=80
GOTIFY_HOSTNAME="gotify.${SERVICES_DOMAIN_NAME}"
GOTIFY_VERSION="2.9.0"

GOTIFY_DEFAULTUSER_NAME="${SERVICES_USER}"
GOTIFY_DEFAULTUSER_PASS="${SERVICES_USER_PASSWORD}"

# Grafana
GRAFANA_HOSTNAME_PORT=3000
GRAFANA_HOSTNAME="grafana.${SERVICES_DOMAIN_NAME}"
GRAFANA_NETWORK="${COMPOSE_PROJECT_NAME}-grafana"
GRAFANA_VERSION="12.3.3"

GRAFANA_GF_SECURITY_ADMIN_PASSWORD="${SERVICES_USER_PASSWORD}"
GRAFANA_GF_SECURITY_ADMIN_USER="${SERVICES_USER}"

GRAFANA_ALLOY_HOSTNAME_PORT=12345
GRAFANA_ALLOY_HOSTNAME="grafana-alloy.${SERVICES_DOMAIN_NAME}"
GRAFANA_ALLOY_VERSION="v1.13.1"

GRAFANA_ALLOY_LOGGING_LEVEL="info"

GRAFANA_LOKI_VERSION="3.6.6"

# homepage
HOMEPAGE_HOSTNAME_PORT=3000
HOMEPAGE_HOSTNAME="homepage.${SERVICES_DOMAIN_NAME}"
HOMEPAGE_VERSION="v1.10.1"

# IT TOOLS
IT_TOOLS_HOSTNAME_PORT=80
IT_TOOLS_HOSTNAME="it-tools.${SERVICES_DOMAIN_NAME}"
IT_TOOLS_VERSION="latest"

# Mailpit
MAILPIT_HOSTNAME_PORT=8025
MAILPIT_HOSTNAME="mailpit.${SERVICES_DOMAIN_NAME}"
MAILPIT_NETWORK="${COMPOSE_PROJECT_NAME}-mailpit"
MAILPIT_VERSION="v1.29"

# Mealie
MEALIE_HOSTNAME_PORT=9000
MEALIE_HOSTNAME="mealie.${SERVICES_DOMAIN_NAME}"
MEALIE_VERSION="v3.11.0"

# MinIO
MINIO_HOSTNAME_PORT=9001
MINIO_HOSTNAME="minio.${SERVICES_DOMAIN_NAME}"
MINIO_NETWORK="${COMPOSE_PROJECT_NAME}-minio"
MINIO_VERSION="RELEASE.2025-09-07T16-13-09Z"

MINIO_ROOT_PASSWORD="${SERVICES_USER_PASSWORD}"
MINIO_ROOT_USER="${SERVICES_USER}"

# Mongo
MONGO_NETWORK="${COMPOSE_PROJECT_NAME}-mongo"
MONGO_VERSION="8.2.5"

MONGO_EXPORTER_USER_PASSWORD="${SERVICES_USER_PASSWORD}"
MONGO_EXPORTER_USER="exporter"
MONGO_GLIBC_TUNABLES="glibc.pthread.rseq=0"
MONGO_INITDB_ROOT_PASSWORD="${SERVICES_USER_PASSWORD}"
MONGO_INITDB_ROOT_USERNAME="${SERVICES_USER}"
MONGO_PROFILE=0

MONGO_EXPRESS_HOSTNAME_PORT=8081
MONGO_EXPRESS_HOSTNAME="mongo-express.${SERVICES_DOMAIN_NAME}"
MONGO_EXPRESS_VERSION="1.0"

MONGO_EXPRESS_ME_CONFIG_OPTIONS_EDITORTHEME="monokai"

MONGO_PROMETHEUS_EXPORTER_VERSION="0.47.1"

# MySQL
MYSQL_NETWORK="${COMPOSE_PROJECT_NAME}-mysql"
MYSQL_VERSION="9.6"

MYSQL_EXPORTER_USER_PASSWORD="${SERVICES_USER_PASSWORD}"
MYSQL_EXPORTER_USER="exporter"
MYSQL_ROOT_PASSWORD="${SERVICES_USER_PASSWORD}"

MYSQL_PHPMYADMIN_HOSTNAME_PORT=80
MYSQL_PHPMYADMIN_HOSTNAME="phpmyadmin.${SERVICES_DOMAIN_NAME}"
MYSQL_PHPMYADMIN_VERSION="5.2.3"

MYSQL_PHPMYADMIN_UPLOAD_LIMIT="1G"

MYSQL_PROMETHEUS_EXPORTER_VERSION="v0.18.0"

# n8n
N8N_HOSTNAME_PORT=5678
N8N_HOSTNAME="n8n.${SERVICES_DOMAIN_NAME}"
N8N_VERSION="2.9.1"

# ollama
OLLAMA_NETWORK="${COMPOSE_PROJECT_NAME}-ollama"
OLLAMA_VERSION="0.16.3"

OLLAMA_MODEL="deepseek-coder-v2:16b"

OLLAMA_OPEN_WEBUI_HOSTNAME_PORT=8080
OLLAMA_OPEN_WEBUI_HOSTNAME="open-webui.${SERVICES_DOMAIN_NAME}"
OLLAMA_OPEN_WEBUI_VERSION="v0.8.3"

OLLAMA_OPEN_WEBUI_WEBUI_SECRET_KEY=""

# Omni Tools
OMNI_TOOLS_HOSTNAME_PORT=80
OMNI_TOOLS_HOSTNAME="omni-tools.${SERVICES_DOMAIN_NAME}"
OMNI_TOOLS_VERSION="0.6.0"

# PostgreSQL
POSTGRES_NETWORK="${COMPOSE_PROJECT_NAME}-postgres"
POSTGRES_VERSION="18.2"

POSTGRES_EXPORTER_USER_PASSWORD="${SERVICES_USER_PASSWORD}"
POSTGRES_EXPORTER_USER="exporter"
POSTGRES_USER_PASSWORD="${SERVICES_USER_PASSWORD}"
POSTGRES_USER="${SERVICES_USER}"

POSTGRES_PGADMIN4_HOSTNAME_PORT=80
POSTGRES_PGADMIN4_HOSTNAME="pgadmin4.${SERVICES_DOMAIN_NAME}"
POSTGRES_PGADMIN4_VERSION="9.12"

POSTGRES_PGADMIN4_DEFAULT_EMAIL="${SERVICES_USER_EMAIL}"
POSTGRES_PGADMIN4_DEFAULT_PASSWORD="${SERVICES_USER_PASSWORD}"

POSTGRES_PROMETHEUS_EXPORTER_VERSION="v0.19.0"

# Prometheus
PROMETHEUS_HOSTNAME_PORT=9090
PROMETHEUS_HOSTNAME="prometheus.${SERVICES_DOMAIN_NAME}"
PROMETHEUS_NETWORK="${COMPOSE_PROJECT_NAME}-prometheus"
PROMETHEUS_VERSION="v3.9.1"

PROMETHEUS_BLACKBOX_EXPORTER_VERSION="v0.28.0"

PROMETHEUS_NODE_EXPORTER_VERSION="v1.10.2"

# RabbitMQ
RABBITMQ_HOSTNAME_PORT=15672
RABBITMQ_HOSTNAME="rabbitmq.${SERVICES_DOMAIN_NAME}"
RABBITMQ_NETWORK="${COMPOSE_PROJECT_NAME}-rabbitmq"
RABBITMQ_VERSION="4.2.4-management-alpine"

RABBITMQ_DEFAULT_PASS="${SERVICES_USER_PASSWORD}"
RABBITMQ_DEFAULT_USER="${SERVICES_USER}"

# Redis
REDIS_HOSTNAME_PORT=5540
REDIS_HOSTNAME="redisinsight.${SERVICES_DOMAIN_NAME}"
REDIS_NETWORK="${COMPOSE_PROJECT_NAME}-redis"
REDIS_VERSION="8.4-alpine"

REDIS_PASSWORD="${SERVICES_USER_PASSWORD}"

REDIS_REDISINSIGHT_VERSION="3.0.3"

REDIS_EXPORTER_VERSION="v1.81.0-alpine"

# Traefik
TRAEFIK_HOSTNAME_PORT=8080
TRAEFIK_HOSTNAME="traefik.${SERVICES_DOMAIN_NAME}"
TRAEFIK_NETWORK="${COMPOSE_PROJECT_NAME}-traefik"
TRAEFIK_VERSION="v3.6.8"

TRAEFIK_WHOAMI_HOSTNAME_PORT=80
TRAEFIK_WHOAMI_HOSTNAME="whoami.${SERVICES_DOMAIN_NAME}"
TRAEFIK_WHOAMI_VERSION="v1.11"

# What's up Docker?
WHATSUPDOCKER_HOSTNAME_PORT=3000
WHATSUPDOCKER_HOSTNAME="whatsupdocker.${SERVICES_DOMAIN_NAME}"
WHATSUPDOCKER_VERSION="8.2.0"

WHATSUPDOCKER_GOTIFY_TOKEN=""
WHATSUPDOCKER_WUD_REGISTRY_CUSTOM_OSGEO_URL="https://docker.osgeo.org/repository/geoserver-docker"

# Proxy
PROXY_NETWORK="${TRAEFIK_NETWORK}"
